  "queries": {
    "market": "SELECT e.year,e.country_code,e.country_name,e.direction,e.hs6,\n e.total_value_1000usd,e.total_value_usd,e.partner_count,\n e.top1_partner_code,e.top1_share,e.top3_share,e.hhi,\n e.positive_quantity_rows,e.missing_quantity_rows,e.nonpositive_quantity_rows,\n e.quantity_covered_value_1000usd,e.quantity_value_coverage_share,\n g.global_value_usd,g.global_supplier_hhi,e.source_version,e.source_archive_sha256\nFROM read_parquet('data/exposures/year=2024/*.parquet',hive_partitioning=false) e\nJOIN read_parquet('data/global_context/year=2024/*.parquet',hive_partitioning=false) g USING(year,hs6)\nWHERE e.country_code=818 AND e.direction='import' AND e.hs6='100110';",
    "partner_evidence": "SELECT year,hs6,exporter_code,exporter_name,importer_code,\n trade_value_1000usd,trade_value_1000usd*1000 AS trade_value_usd,\n cast(trade_value_1000usd AS DOUBLE)/cast(sum(trade_value_1000usd) OVER() AS DOUBLE) AS share,\n quantity_tonnes,quantity_missing,v_raw,q_raw,source_member,source_record_ordinal,\n source_version,source_archive_sha256\nFROM read_parquet('data/flows/year=2024/*.parquet',hive_partitioning=false)\nWHERE importer_code=818 AND hs6='100110'\nORDER BY trade_value_1000usd DESC,exporter_code;"
  },
